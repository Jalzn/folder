{
  "name": "tinyfold",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build --config src/web/vite.config.ts",
    "start": "tsx --env-file-if-exists=.env src/server/main.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm deps && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "deps": "depcruise project.ts src scripts e2e --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "tokens": "tsx src/web/styles/tokens/write.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/cli/migrate.ts",
    "reset-password": "tsx --env-file-if-exists=.env src/server/cli/reset-password.ts",
    "backup:create": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "backup:restore": "tsx --env-file-if-exists=.env scripts/restore.ts",
    "seed:sample": "tsx --env-file-if-exists=.env scripts/seed-sample.ts",
    "e2e:visual": "playwright test --config playwright.visual.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.20",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.7.0",
    "happy-dom": "21.0.4",
    "railway": "3.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "imports": {
    "#auth": "./src/auth/index.ts",
    "#auth/domain": "./src/auth/domain/index.ts",
    "#board": "./src/board/index.ts",
    "#board/composition": "./src/board/infra/composition.ts",
    "#board/contracts": "./src/board/application/contracts/index.ts",
    "#board/domain": "./src/board/domain/index.ts",
    "#core/application": "./src/core/application/index.ts",
    "#core/domain": "./src/core/domain/index.ts",
    "#core/infra": "./src/core/infra/index.ts",
    "#core/testing": "./src/core/testing/index.ts",
    "#documents": "./src/documents/index.ts",
    "#documents/composition": "./src/documents/infra/composition.ts",
    "#documents/contracts": "./src/documents/application/contracts/index.ts",
    "#documents/domain": "./src/documents/domain/index.ts",
    "#drawings": "./src/drawings/index.ts",
    "#drawings/composition": "./src/drawings/infra/composition.ts",
    "#drawings/contracts": "./src/drawings/application/contracts/index.ts",
    "#drawings/domain": "./src/drawings/domain/index.ts",
    "#project": "./project.ts",
    "#projects": "./src/projects/index.ts",
    "#projects/composition": "./src/projects/infra/composition.ts",
    "#projects/contracts": "./src/projects/application/contracts/index.ts",
    "#projects/domain": "./src/projects/domain/index.ts",
    "#rich-text/domain": "./src/rich-text/domain/index.ts",
    "#server/application": "./src/server/application.ts",
    "#server/router": "./src/server/router.ts",
    "#server/workspace": "./src/server/workspace/index.ts",
    "#workspace": "./src/workspace/index.ts",
    "#workspace/composition": "./src/workspace/infra/composition.ts",
    "#workspace/contracts": "./src/workspace/application/contracts/index.ts",
    "#workspace/domain": "./src/workspace/domain/index.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.56.0",
    "@blocknote/mantine": "0.56.0",
    "@blocknote/math-block": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@orpc/client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tiptap/pm": "3.32.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13",
    "inter-ui": "4.1.1",
    "kysely": "0.29.7",
    "lucide-react": "1.61.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  }
}
