# A senha cria a conta apenas na primeira subida. Defina uma senha de 12 a 256 caracteres.
OWNER_PASSWORD=
OWNER_NAME=Você
DATABASE_PATH=data/tinyfold.sqlite
APP_ORIGIN=http://localhost:5170
PORT=3370
WEB_PORT=5170
HOST=127.0.0.1
COOKIE_SECURE=false
TRUST_PROXY=false
# Produção: WEB_DIR=src/web/dist, APP_ORIGIN=https://seu-dominio e COOKIE_SECURE=true.
# O arquivo SQLite precisa ficar em volume persistente: DATABASE_PATH=/data/tinyfold.sqlite.
# Railway: BACKUP_DIR=/data/backups no mesmo volume, com cópia externa dos snapshots.
# Configuração completa de Railway e Cloudflare: docs/railway.md.
# Origem desta instalação em produção: https://folder.jalzn.com.
BACKUP_DIR=backups
