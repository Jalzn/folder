{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx"],
  "exclude": ["node_modules", "src/web/dist"]
}
